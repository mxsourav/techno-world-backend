generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  name                String
  role                Role                 @default(CUSTOMER)
  isActive            Boolean              @default(true)
  googleId            String?              @unique
  avatarUrl           String?
  phone               String?
  technoPoints        Int                  @default(0)
  pendingPoints       Int                  @default(0)
  tokenVersion        Int                  @default(1)
  failedLogins        Int                  @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  activityLogs        ActivityLog[]
  addresses           Address[]
  cartItems           CartItem[]
  notifications       Notification[]
  orders              Order[]
  pointTransactions   PointTransaction[]
  reviews             Review[]
  questions           BookQuestion[]
  savedPaymentMethods SavedPaymentMethod[]
  sessions            Session[]
  wishlistItems       WishlistItem[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique @db.VarChar(512)
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}

model Book {
  id               String             @id @default(uuid())
  title            String
  subtitle         String?
  slug             String             @unique
  isbn10           String?            @unique
  isbn13           String?            @unique
  edition          String?
  language         String             @default("English")
  description      String             @db.Text
  shortDescription String?            @db.Text
  price            Float
  mrp              Float
  costPrice        Float?
  discount         Float              @default(0)
  stock            Int                @default(0)
  reservedStock    Int                @default(0)
  reorderLevel     Int                @default(20)
  warehouse        String?            @default("Main Warehouse")
  lifetimeSales    Int                @default(0)
  weight           Float?
  dimensions       String?
  pages            Int?
  publicationDate  DateTime?
  publicationYear  Int?
  printYear        Int?
  reprintNumber    Int?
  bindingType      String?
  coverType        String?
  barcode          String?
  series           String?
  volume           String?
  sku              String?            @unique
  bookCode         String?            @unique
  university       String?
  semester         String?
  course           String?
  examination      String?
  classStandard    String?
  coverUrl         String?
  galleryUrls      String?            @default("[]")
  previewPdfUrl    String?
  status           BookStatus         @default(DRAFT)
  visibility       Boolean            @default(true)
  isFeatured       Boolean            @default(false)
  isTrending       Boolean            @default(false)
  isNewArrival     Boolean            @default(false)
  isBestseller     Boolean            @default(false)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?            @default("[]")
  tags             String?            @default("[]")
  categoryId       String?
  bookTypeId       String?
  publisherId      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  bookType         BookType?          @relation(fields: [bookTypeId], references: [id])
  category         Category?          @relation(fields: [categoryId], references: [id])
  publisher        Publisher?         @relation(fields: [publisherId], references: [id])
  cartItems        CartItem[]
  inventoryHistory InventoryHistory[]
  orderItems       OrderItem[]
  reviews          Review[]
  questions        BookQuestion[]
  wishlistItems    WishlistItem[]
  authors          Author[]           @relation("AuthorToBook")
  subjects         Subject[]          @relation("BookToSubject")

  @@index([categoryId])
  @@index([bookTypeId])
  @@index([publisherId])
  @@index([status])
  @@index([slug])
}

model Category {
  id             String      @id @default(uuid())
  name           String
  slug           String      @unique
  description    String?
  imageUrl       String?
  iconUrl        String?
  sortOrder      Int         @default(0)
  isActive       Boolean     @default(true)
  seoTitle       String?
  seoDescription String?
  parentId       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  books          Book[]
  parent         Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]  @relation("CategoryTree")
  promotions     Promotion[]

  @@index([parentId])
  @@index([slug])
}

model BookType {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  books       Book[]

  @@index([slug])
}

model Subject {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  books       Book[]   @relation("BookToSubject")

  @@index([slug])
}

model Author {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  bio         String?  @db.Text
  imageUrl    String?
  socialLinks String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  biography   String?  @db.Text
  books       Book[]   @relation("AuthorToBook")

  @@index([slug])
}

model Publisher {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  logoUrl      String?
  contactEmail String?
  contactPhone String?
  website      String?
  address      String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  books        Book[]

  @@index([slug])
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  fullName     String
  phone        String
  email        String?
  addressLine1 String
  addressLine2 String?
  postOffice   String?
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  type         String   @default("HOME")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([userId])
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  userId          String
  addressId       String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentId       String?
  paymentMethod   String?
  subtotal        Float
  shippingCharge  Float         @default(0)
  taxAmount       Float         @default(0)
  discountAmount  Float         @default(0)
  totalAmount     Float
  promotionId     String?
  trackingNumber  String?
  shippingCarrier String?
  shippingMethod  String?
  customerEmail   String?
  pickupName      String?
  pickupPhone     String?
  pickupEmail     String?
  pickupSlots     String?       @db.Text
  selectedPickupSlot String?
  pickupStatus    String?       @default("NONE")
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  address         Address?      @relation(fields: [addressId], references: [id])
  promotion       Promotion?    @relation(fields: [promotionId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([addressId], map: "Order_addressId_fkey")
  @@index([promotionId], map: "Order_promotionId_fkey")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  bookId          String
  quantity        Int
  priceAtPurchase Float
  createdAt       DateTime @default(now())
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([bookId])
}

model Review {
  id         String   @id @default(uuid())
  userId     String?
  bookId     String
  userName   String?
  userEmail  String?
  rating     Int
  title      String?
  content    String   @db.Text
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId])
}

model BookQuestion {
  id         String    @id @default(uuid())
  bookId     String
  userId     String?
  userName   String?
  userEmail  String?
  question   String    @db.Text
  answer     String?   @db.Text
  answeredBy String?
  answeredAt DateTime?
  status     String    @default("PENDING")
  isApproved Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([status])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId], map: "WishlistItem_bookId_fkey")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId], map: "CartItem_bookId_fkey")
}

model HomepageCMS {
  id         String   @id @default(uuid())
  sectionKey String   @unique
  title      String?
  isEnabled  Boolean  @default(true)
  sortOrder  Int      @default(0)
  configData String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Media {
  id           String    @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  folder       String    @default("/")
  type         MediaType @default(IMAGE)
  altText      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([folder])
  @@index([type])
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@index([key])
}

model ActivityLog {
  id        String         @id @default(uuid())
  userId    String?
  action    ActivityAction
  entity    String
  entityId  String?
  details   String?        @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  type      String   @default("info")
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Campaign {
  id             String      @id @default(uuid())
  name           String
  description    String?
  status         String      @default("DRAFT")
  startDate      DateTime?
  endDate        DateTime?
  budget         Float?
  priority       Int         @default(0)
  marketingNotes String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  promotions     Promotion[]
}

model Promotion {
  id                String           @id @default(uuid())
  campaignId        String?
  name              String
  code              String?          @unique
  description       String?          @db.Text
  promotionType     String           @default("UNIVERSAL")
  discountType      String           @default("PERCENTAGE")
  discountValue     Float            @default(0)
  isTemplate        Boolean          @default(false)
  status            String           @default("DRAFT")
  validFrom         DateTime?
  validUntil        DateTime?
  priority          Int              @default(0)
  allowCombination  Boolean          @default(false)
  autoApply         Boolean          @default(false)
  rules             String           @default("{}") @db.Text
  usageLimit        Int?
  usageLimitPerUser Int              @default(1)
  usedCount         Int              @default(0)
  categoryId        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  orders            Order[]
  campaign          Campaign?        @relation(fields: [campaignId], references: [id])
  category          Category?        @relation(fields: [categoryId], references: [id])
  usages            PromotionUsage[]

  @@index([code])
  @@index([categoryId])
  @@index([campaignId], map: "Promotion_campaignId_fkey")
}

model PromotionUsage {
  id          String    @id @default(uuid())
  promotionId String
  userId      String
  orderId     String?
  usedAt      DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, userId, orderId])
  @@index([promotionId])
  @@index([userId])
}

model InventoryHistory {
  id        String   @id @default(uuid())
  bookId    String
  change    Int
  reason    String
  reference String?
  createdAt DateTime @default(now())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([createdAt])
}

model SavedPaymentMethod {
  id         String   @id @default(uuid())
  userId     String
  type       String
  provider   String?
  maskedData String?
  holderName String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PointTransaction {
  id          String   @id @default(uuid())
  userId      String
  orderId     String?
  points      Int
  type        String
  status      String   @default("CREDITED")
  description String?  @db.Text
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id           String   @id @default(uuid())
  toEmail      String
  senderEmail  String
  senderName   String?
  subject      String
  message      String   @db.Text
  htmlContent  String?  @db.LongText
  orderNumber  String?
  provider     String   @default("SMTP")
  status       String   @default("SENT")
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([toEmail])
  @@index([orderNumber])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CONTENT_MANAGER
  ORDER_MANAGER
  EMPLOYEE
  CUSTOMER
}

enum BookStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum MediaType {
  IMAGE
  PDF
  DOCUMENT
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  IMPORT
  EXPORT
  SETTINGS_CHANGE
}

model SearchLog {
  id             String   @id @default(uuid())
  query          String
  userId         String?
  resultsCount   Int      @default(0)
  source         String?  @default("instant")
  matchedBookIds String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([query])
  @@index([createdAt])
}


